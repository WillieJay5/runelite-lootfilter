meta
{ name = "WillieJay"; 
  description = "Shows important items as well as resources"; }

// OWNERSHIP
if
( ownership:0
  || ownership:2 )
{ hidden = true; }
  
// TODO -  change wildards to specific items, change ground text color to match menu text color

// HIDDEN
if
( name:"potato seed"
  || name:"onion seed"
  || name:"cabbage seed"
  || name:"tomato seed"
  || name:"sweetcorn seed"
  || name:"strawberry seed"
  || name:"watermelon seed"
  || name:"marigold seed"
  || name:"rosemary seed"
  || name:"nasturtium seed"
  || name:"woad seed"
  || name:"limpwurt seed"
  || name:"guam seed"
  || name:"marrentill seed"
  || name:"tarromin seed"
  || name:"barley seed"
  || name:"hammerstone seed"
  || name:"asgarnian seed"
  || name:"jute seed"
  || name:"yanillian seed"
  || name:"krandorian seed"
  || name:"wildblood seed"
  || name:"redberry seed"
  || name:"cadavaberry seed"
  || name:"dwellberry seed"
  || name:"jangerberry seed"
  || name:"whiteberry seed"
  || name:"poison ivy seed"
  || name:"mushroom spore"
  || name:"belladonna seed"
  || name:"cactus seed"
  || name:"potato cactus seed"
  || name:"ensouled goblin head"
  || name:"ensouled monkey head"
  || name:"ensouled imp head"
  || name:"ensouled minotaur head"
  || name:"ensouled scorpion head"
  || name:"ensouled bear head"
  || name:"ensouled unicorn head"
  || name:"copper ore"
  || name:"tin ore"
  || name:"waterskin*"
  || name:"runite ore"
  && stackable:false 
  || name:"runite bar"
  && stackable:false 
  || name:"gryphon feather"
  && quantity:<10 )
{ hidden = true; }

// DROPS — MISCELLANEOUS
if
( name:"alchemist's signet"
  || name:"broken antler"
  || name:"* champion scroll"
  || name:"crystal key"
  || name:"crystal shard"
  || name:"curved bone"
  || name:"giant key"
  || name:"grubby key"
  || name:"gryphon feather"
  || name:"* half of key"
  || name:"long bone"
  || name:"mossy key"
  || name:"scaly blue dragonhide"
  || name:"scurrius' spine"
  || name:"zombie pirate key" )
{ textColor = "#ffffff";
  menuTextColor = "#990000";
  borderColor = "#990000";
  backgroundColor = "#69990000";
  icon = CurrentItem(); 
  }


//Unique tier 5
if (value: >100000000 && stackable:false)
{  textColor = "#ffffffff";
  borderColor = "#a400ff";
  menuTextColor = "#a400ff";
  backgroundColor = "#69a400ff";
  icon = CurrentItem();
  showLootbeam = true;
  lootbeamColor = "#a400ff";
}

//Uniques Tier 4

if (value:>50000000 && value: <99999999 && stackable:false)
{  textColor = "#ffffff";
  borderColor = "#ff88e1";
  menuTextColor = "#ff88e1";
  backgroundColor = "#69ff88e1";
  icon = CurrentItem();
  showLootbeam = true;
  lootbeamColor = "#ff88e1"; 
}

//Uniques Tier 3
if (value:>10000000 && value:<49999999 && stackable:false)
{  textColor = "#ffffff";
